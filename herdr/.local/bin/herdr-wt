#!/usr/bin/env bash
# Open a branch as a herdr worktree workspace next to the main clone.
#   herdr-wt <name>          new theo/<name> from origin's default branch
#   herdr-wt <branch>        existing local or remote branch (someone else's too)
#   herdr-wt <#123|123>      GitHub pull request head
#   herdr-wt                 list worktrees of this repo, or of every repo in ~/Developer
# Extra args are passed to herdr (default --focus). Prints herdr's JSON.
set -euo pipefail

prefix="${HERDR_WORKTREE_PREFIX:-theo}"

# ● working  ◆ blocked  ✓ done  ○ open in herdr  · closed
list() {
  local open root path branch mark state changes ab
  open=$(herdr workspace list 2>/dev/null \
    | jq -r '.result.workspaces[] | select(.worktree) | "\(.worktree.checkout_path)\t\(.agent_status)"' || true)
  for root in "$@"; do
    git -C "$root" worktree list --porcelain | awk '
      /^worktree /{p=substr($0,10)} /^branch /{b=substr($0,19)} /^detached/{b="(detached)"}
      /^$/{if (n++) print p "\t" b; b=""}' \
    | { first=1; while IFS=$'\t' read -r path branch; do
        ((first)) && printf '%s\n' "$(basename "$root")" && first=0
        state=$(awk -F'\t' -v p="$path" '$1==p{print $2}' <<<"$open")
        case "$state" in working) mark=●;; blocked) mark=◆;; done) mark=✓;; "") mark=·;; *) mark=○;; esac
        if [[ -d "$path" ]]; then
          changes=$(git -C "$path" status --porcelain | wc -l | tr -d ' ')
          ab=$(git -C "$path" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null | awk '{print "↓"$1" ↑"$2}')
        else
          changes=missing ab="prune"
        fi
        printf '  %s %-34s %-10s %s\n' "$mark" "$branch" "${changes/#0/clean}" "${ab:-no upstream}"
      done; }
  done
}

if [[ $# -eq 0 ]]; then
  if root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    list "$(dirname "$root")"
  else
    list $(for d in ~/Developer/*/; do [[ -d "$d.git" ]] && echo "${d%/}"; done)
  fi
  exit
fi
arg=$1
shift
flags=("${@:---focus}")

root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
repo=$(basename "$root")
git -C "$root" fetch -q --prune origin

if [[ "$arg" =~ ^#?([0-9]+)$ ]]; then
  branch="pr/${BASH_REMATCH[1]}"
  git -C "$root" fetch -q origin "+pull/${BASH_REMATCH[1]}/head:$branch"
elif git -C "$root" show-ref -q --verify "refs/heads/$arg" \
  || git -C "$root" show-ref -q --verify "refs/remotes/origin/$arg"; then
  branch="$arg"
else
  branch="$prefix/${arg#"$prefix/"}"
fi

slug=${branch//\//-}
path="$(dirname "$root")/$repo.$slug"
label=${slug#"$prefix-"}

existing=$(git -C "$root" worktree list --porcelain \
  | awk -v b="branch refs/heads/$branch" '/^worktree /{p=substr($0,10)} $0==b{print p}')

if [[ -n "$existing" ]]; then
  exec herdr worktree open --cwd "$root" --path "$existing" --label "$label" "${flags[@]}"
elif git -C "$root" show-ref -q --verify "refs/heads/$branch"; then
  git -C "$root" worktree add -q "$path" "$branch"
elif git -C "$root" show-ref -q --verify "refs/remotes/origin/$branch"; then
  git -C "$root" worktree add -q --track -b "$branch" "$path" "origin/$branch"
else
  base=$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)
  exec herdr worktree create --cwd "$root" --branch "$branch" --base "$base" \
    --path "$path" --label "$label" "${flags[@]}"
fi
exec herdr worktree open --cwd "$root" --path "$path" --label "$label" "${flags[@]}"
