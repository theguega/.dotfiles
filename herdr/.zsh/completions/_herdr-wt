#compdef herdr-wt

local -aU subcmds branches worktrees
local root

if (( CURRENT == 2 )); then
  subcmds=('ls:list worktrees' 'rm:remove a worktree' 'prompt:ask for a name, branch or #pr')
  branches=(${(f)"$(git for-each-ref --format='%(refname:lstrip=2)' refs/heads 2>/dev/null)"}
            ${${(f)"$(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin 2>/dev/null)"}:#HEAD})
  _describe -t commands 'command' subcmds
  _describe -t branches 'branch' branches
elif [[ $words[2] == rm ]]; then
  root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return
  worktrees=(${${(f)"$(git worktree list --porcelain | sed -n 's/^worktree //p')"}:#${root:h}})
  _arguments '-f[remove even with uncommitted changes]' "*:worktree:(${(q)worktrees})"
fi
